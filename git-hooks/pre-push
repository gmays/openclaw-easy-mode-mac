#!/bin/sh

REMOTE_NAME="${1:-}"
TMP_INPUT="$(mktemp "${TMPDIR:-/tmp}/openclaw-pre-push.stdin.XXXXXX")"
trap 'rm -f "$TMP_INPUT"' EXIT
cat > "$TMP_INPUT"

if [ -d "/opt/homebrew/bin" ]; then
  PATH="/opt/homebrew/bin:$PATH"
fi
if [ -d "/usr/local/bin" ]; then
  PATH="/usr/local/bin:$PATH"
fi
if [ -d "$HOME/.volta/bin" ]; then
  PATH="$HOME/.volta/bin:$PATH"
fi
if [ -d "$HOME/.asdf/shims" ]; then
  PATH="$HOME/.asdf/shims:$PATH"
fi

if [ "${CODEX_REVIEW_ENABLED:-1}" = "0" ] || [ "${CODEX_REVIEW_PUSH_GATE_ENABLED:-1}" = "0" ]; then
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
REVIEWS_DIR="${CODEX_REVIEW_DIR:-$REPO_ROOT/.code-reviews}"
case "$REVIEWS_DIR" in
  /*) ;;
  *) REVIEWS_DIR="$REPO_ROOT/$REVIEWS_DIR" ;;
esac

LOG_DIR="$REVIEWS_DIR/logs"
mkdir -p "$LOG_DIR" 2>/dev/null || true
LOG_FILE="$LOG_DIR/pre-push.log"

cd "$REPO_ROOT" || exit 1

if scripts/codex-review-push-gate --stdin-file "$TMP_INPUT" --remote-name "$REMOTE_NAME" >> "$LOG_FILE" 2>&1; then
  exit 0
fi

scripts/codex-review-inbox --mode catch-up --stdin-file "$TMP_INPUT" --remote-name "$REMOTE_NAME" >> "$LOG_FILE" 2>&1 || true
echo "PRE-PUSH FAILED: unresolved Codex commit review findings" >&2
echo "Resolve or dismiss findings under $REVIEWS_DIR, or bypass with CODEX_REVIEW_PUSH_GATE_BYPASS=1" >&2
exit 1
